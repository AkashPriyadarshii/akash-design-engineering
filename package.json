{
  "name": "@design-engineer/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency, high-craft software design engineering toolkit and agent skill",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "node --test packages/**/tests/*.test.ts",
    "audit": "node bin/audit.mjs",
    "audit:packages": "node bin/audit.mjs packages",
    "audit:website": "node bin/audit.mjs website"
  },
  "keywords": [
    "design-engineering",
    "spring-physics",
    "webgpu",
    "glsl",
    "web-audio",
    "oklch",
    "anti-slop",
    "zero-dependency",
    "haptics",
    "jetpack-compose",
    "react-hooks"
  ],
  "author": "Akash Priyadarshi",
  "license": "MIT"
}
